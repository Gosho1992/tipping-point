# Copy this file to .env and fill in your key. Never commit .env.

# A dedicated OpenAI project key for Tipping Point (server only)
OPENAI_API_KEY=

# Model per task
MODEL_TURN=gpt-6-luna
MODEL_VALUES=gpt-6-luna
MODEL_SCORES=gpt-6-luna
MODEL_FUTURES=gpt-6-luna
REASONING_EFFORT=low
AI_TIMEOUT_S=30

# Output-token caps per task
MAX_OUT_TURN=2000
MAX_OUT_VALUES=800
MAX_OUT_SCORES=2000
MAX_OUT_FUTURES=1000

# Prices in USD per 1M tokens (checked 18 Oct 2026 — update if OpenAI changes them)
PRICE_IN_PER_M_GPT_6_LUNA=0.10
PRICE_OUT_PER_M_GPT_6_LUNA=0.50
PRICE_IN_PER_M_GPT_6_1_SOL=2.00
PRICE_OUT_PER_M_GPT_6_1_SOL=10.00

# Usage caps (per UTC day)
LIMIT_VISITOR_CALLS=45
LIMIT_NETWORK_CALLS=90
LIMIT_GLOBAL_CALLS=1500
DAILY_SPEND_CAP_USD=1.00
IP_HASH_SALT=change-me-to-a-long-random-string

# Decision engine
DEALBREAKER_FAIL=3
TARGET_ANSWERS=5
